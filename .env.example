# Copy this file to .env and fill in your bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Optional: set to "cpu" to run without the GPU.
DEMUCS_DEVICE=cuda

# Optional: Sentry error tracking. Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
